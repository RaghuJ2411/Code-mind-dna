# CodeMind DNA - Environment Configuration
# Copy this file to .env and adjust values for your environment

# === Application ===
APP_NAME=CodeMind DNA API
LOG_LEVEL=INFO
LOG_FORMAT=json

# === Database ===
# For local development with SQLite:
DATABASE_URL=sqlite:///./codemind_dna.db
# For production with PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/codemind_dna

# === Security ===
# IMPORTANT: Generate a strong random key for production!
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-secret-key-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# === CORS ===
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === Password Policy ===
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL_CHAR=true

# === Auth Rate Limiting ===
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# === Request Limits ===
MAX_REQUEST_BODY_SIZE_MB=10

# === AI / LLM Configuration ===
AI_ENABLED=false
AI_PROVIDER=mock
AI_MODEL=gpt-4
AI_API_KEY=
AI_BASE_URL=
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# AI Daily Limits
AI_DAILY_LIMITS_CODE_REVIEW=10
AI_DAILY_LIMITS_ERROR_EXPLAIN=15
AI_DAILY_LIMITS_SKILL_GAP=10
AI_DAILY_LIMITS_ROADMAP=2

# === Code Execution ===
CODE_EXECUTION_PROVIDER=local
CODE_EXECUTION_BASE_URL=
CODE_EXECUTION_API_KEY=
CODE_EXECUTION_TIMEOUT_SECONDS=10
CODING_SESSION_IDLE_MINUTES=30
